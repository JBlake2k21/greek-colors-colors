generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url = "file:./dev.db"
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  // NextAuth fields
}


model Collection {
  id          String   @id @default(uuid())
  name        String
  description String?
  images      String? // JSON string of collection banner image URLs
  displayOrder Int     @default(0)
  isFeatured  Boolean  @default(false)
  products    Product[]
}

model Product {
  id           String     @id @default(uuid())
  title        String
  price        Decimal
  description  String?
  inStock      Boolean    @default(true)
  images       String? // JSON string of product image URLs
  collection   Collection @relation(fields: [collectionId], references: [id])
  collectionId String
}

// NextAuth models (from @auth/prisma-adapter)
model Account {
  id                 String   @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?

  // Relations
  accounts Account[]
  sessions Session[]
}

